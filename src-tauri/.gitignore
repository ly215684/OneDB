# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# VC++ runtime DLLs staged by CI (release.yml) for bundling.
# Populated on the Windows runner from the MSVC redist; never committed.
/vcredist/

# Tauri config override generated by CI (release.yml) to bundle the DLLs above
# only on Windows. See `args: --config ...` in the windows matrix entry.
/tauri.release.conf.json
